#!/bin/sh
# Launch smoke test before every push: plays the first run + trial 1 in
# headless Chrome and fails on any page error (scripts/smoke.cjs, ~50 s).
# Skip once with: SKIP_SMOKE=1 git push   (or git push --no-verify)
[ -n "$SKIP_SMOKE" ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ ! -d scripts/node_modules/puppeteer-core ]; then
  echo "pre-push: smoke test needs 'npm install' in scripts/ (or push with SKIP_SMOKE=1)" >&2
  exit 1
fi
echo "pre-push: running launch smoke test…" >&2
node scripts/smoke.cjs
